# Kopiere nach .env (gitignored) und trage deinen ISIS-Token ein.
# In der Claude-Cloud-Umgebung stattdessen als Environment variable setzen.
ISIS_TOKEN=

# Lernpodcast: geheimer Pfadteil der Feed-URL (≥ 16 Zeichen, A-Z a-z 0-9 _ -). Erzeugen mit:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Wer den Pfad kennt, kann die Folgen hören – nicht teilen, nicht committen. Siehe docs/PODCAST.md.
PODCAST_SECRET=
